{% extends 'base.html.twig' %}


{% block body %}
<section id="add">
    <a href="index.html">← Retour</a>
    <h1>Ajouter une voiture</h1>
        {{ form_start(form) }}
            <div class="input">
                {{ form_row(form.name)}}
            </div>
            <div class="input">
                {{ form_row(form.description)}}
            </div>
            <div class="flex-input">
                <div class="input">
                    {{ form_row(form.dailyPrice)}}
                </div>
                <div class="input">
                    {{ form_row(form.monthlyPrice)}}
                </div>
            </div>
            <div class="flex-input">
                <div class="input">
                    {{ form_row(form.places)}}
                </div>
                <div class="input">
                {{ form_row(form.motor)}}
            </div>
            </div>
            
        <button class="btn-add">Ajouter</button>
        {{ form_end(form) }}
    </form>
</section>

{% endblock %}
